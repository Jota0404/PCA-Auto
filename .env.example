# PostgreSQL connection used by Prisma.
# Example: postgresql://postgres:postgres@localhost:5432/pca_auto
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pca_auto"

# Optional runtime settings for the future e-Compras integration.
# Keep credentials and authenticated session artifacts out of source control.
ECOMPRAS_BASE_URL="https://portal.compras.df.gov.br"
